@model IList<Unit>

@if (Model.Count == 0)
{
    <p class="text-muted mb-0">No units yet.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Unit</th>
                <th>Type</th>
                <th>Bedrooms</th>
                <th>Rent</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var unit in Model)
            {
                <tr>
                    <td>@unit.UnitNumber</td>
                    <td>@unit.UnitType.Name@if (!unit.UnitType.IsActive) { <span class="text-muted">(inactive)</span> }</td>
                    <td>@unit.Bedrooms</td>
                    <td>@unit.MonthlyRent.ToString("C")</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-modal-load="@Url.Action("EditUnitModal", "Properties", new { id = unit.Id })">Edit</button>
                        <button type="button" class="btn btn-sm btn-outline-danger unit-delete" data-url="@Url.Action("DeleteUnit", "Properties")" data-id="@unit.Id">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<script>
    document.querySelectorAll('.unit-delete').forEach(btn => {
        btn.addEventListener('click', () => {
            if (!confirm('Delete this unit?')) return;
            RentalModals.postJson(btn.dataset.url, { id: parseInt(btn.dataset.id, 10) })
                .then(() => location.reload())
                .catch(err => alert(err.message || 'Could not delete unit.'));
        });
    });
</script>
