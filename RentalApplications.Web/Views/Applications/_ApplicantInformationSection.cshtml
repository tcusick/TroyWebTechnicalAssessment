@model RentalApplicationFormViewModel

<div id="applicant-section">
    <fieldset @(Model.IsReadOnly ? "disabled" : null)>
        <div class="mb-3">
            <label asp-for="ApplicantInformation.ApplicantName" class="form-label"></label>
            <input asp-for="ApplicantInformation.ApplicantName" class="form-control" />
            <span asp-validation-for="ApplicantInformation.ApplicantName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ApplicantInformation.Phone" class="form-label"></label>
            <input asp-for="ApplicantInformation.Phone" class="form-control" type="tel" autocomplete="tel" />
            <span asp-validation-for="ApplicantInformation.Phone" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ApplicantInformation.Email" class="form-label"></label>
            <input asp-for="ApplicantInformation.Email" class="form-control" type="email" autocomplete="email" />
            <span asp-validation-for="ApplicantInformation.Email" class="text-danger"></span>
        </div>
        <div class="mb-2">
            <span class="form-label d-block">Current address</span>
            @Html.EditorFor(m => m.ApplicantInformation.CurrentAddress)
        </div>
    </fieldset>
</div>
