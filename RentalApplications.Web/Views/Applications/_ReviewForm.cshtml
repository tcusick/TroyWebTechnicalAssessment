@model ReviewApplicationViewModel
@using RentalApplications.Validation
@{
    var minLeaseStart = DateValidationRules.UtcToday.ToString("yyyy-MM-dd");
    var maxLeaseStart = DateValidationRules.MaxLeaseStartDate.ToString("yyyy-MM-dd");
}

<div class="modal-header">
    <h5 class="modal-title">Review application</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form asp-action="Review" method="post" data-modal-form="true" data-success-reload="true">
    <div class="modal-body">
        <input type="hidden" asp-for="ApplicationId" />
        <p class="mb-1"><strong>@Model.ApplicantName</strong></p>
        <p class="text-muted">@Model.UnitSummary</p>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Outcome" class="form-label"></label>
            <select asp-for="Outcome" class="form-select" id="reviewOutcome">
                <option value="@ReviewOutcome.Approve">Approve</option>
                <option value="@ReviewOutcome.Return">Return</option>
                <option value="@ReviewOutcome.Deny">Deny</option>
            </select>
        </div>
        <div class="mb-3" id="leaseStartGroup">
            <label asp-for="LeaseStartDate" class="form-label"></label>
            <input asp-for="LeaseStartDate" class="form-control" type="date" min="@minLeaseStart" max="@maxLeaseStart" />
            <span asp-validation-for="LeaseStartDate" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Comment" class="form-label"></label>
            <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Comment" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save outcome</button>
    </div>
</form>
<script>
    (function () {
        const outcome = document.getElementById('reviewOutcome');
        const leaseGroup = document.getElementById('leaseStartGroup');
        function toggle() {
            leaseGroup.style.display = outcome.value === '@ReviewOutcome.Approve' ? '' : 'none';
        }
        outcome?.addEventListener('change', toggle);
        toggle();
    })();
</script>
