@model IList<Property>
@{
    ViewData["Title"] = "Properties";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Properties</h1>
    <button type="button" class="btn btn-primary" data-modal-load="@Url.Action("CreatePropertyModal")">Add property</button>
</div>

@foreach (var property in Model)
{
    <div class="card mb-4" id="property-@property.Id">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <strong>@property.Name</strong>
                <div class="text-muted small">@property.StreetAddress, @property.City, @property.State @property.PostalCode</div>
            </div>
            <div class="btn-group">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-modal-load="@Url.Action("EditPropertyModal", new { id = property.Id })">Edit</button>
                <button type="button" class="btn btn-sm btn-outline-danger" data-post-json="@Url.Action("DeleteProperty")" data-post-data='{"id":@property.Id}' data-refresh-selector="#property-@property.Id" data-refresh-action="remove">Delete</button>
            </div>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h5 mb-0">Units</h2>
                <button type="button" class="btn btn-sm btn-primary" data-modal-load="@Url.Action("CreateUnitModal", new { propertyId = property.Id })">Add unit</button>
            </div>
            @await Component.InvokeAsync("PropertyUnitList", new { propertyId = property.Id })
        </div>
    </div>
}

<div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="appModalContent"></div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-post-json]').forEach(btn => {
            btn.addEventListener('click', () => {
                const url = btn.dataset.postJson;
                const data = JSON.parse(btn.dataset.postData || '{}');
                RentalModals.postJson(url, data).then(() => {
                    if (btn.dataset.refreshAction === 'remove') {
                        document.querySelector(btn.dataset.refreshSelector)?.remove();
                    } else {
                        location.reload();
                    }
                }).catch(err => alert(err.message || 'Request failed.'));
            });
        });
    </script>
}
