@model UnitFormViewModel

<div class="modal-header">
    <h5 class="modal-title">@(Model.Id is > 0 ? "Edit unit" : "Add unit")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form asp-action="SaveUnit" method="post" data-modal-form="true" data-success-reload="true">
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PropertyId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="UnitNumber" class="form-label"></label>
            <input asp-for="UnitNumber" class="form-control" />
            <span asp-validation-for="UnitNumber" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Bedrooms" class="form-label"></label>
                <input asp-for="Bedrooms" class="form-control" />
                <span asp-validation-for="Bedrooms" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="MonthlyRent" class="form-label"></label>
                <input asp-for="MonthlyRent" class="form-control" />
                <span asp-validation-for="MonthlyRent" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="UnitTypeId" class="form-label"></label>
                <select asp-for="UnitTypeId" class="form-select"
                        asp-items="@(new SelectList(Model.UnitTypeOptions, nameof(UnitTypeOptionViewModel.Id), nameof(UnitTypeOptionViewModel.Name)))">
                </select>
                <span asp-validation-for="UnitTypeId" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
